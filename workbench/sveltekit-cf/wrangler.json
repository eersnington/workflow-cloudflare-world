{
  "name": "workflow-app",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2024-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workflow-db",
      "migrations_dir": "migrations",
      "database_id": "a1e21e0e-cfea-4b93-a87e-0c4620cd85d2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_COORDINATOR",
        "class_name": "StreamCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "stream-coordinator-v1",
      "new_classes": ["StreamCoordinator"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WORKFLOW_QUEUE",
        "queue": "workflow-queue"
      },
      {
        "binding": "STEP_QUEUE",
        "queue": "step-queue"
      }
    ],
    "consumers": [
      {
        "queue": "workflow-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      },
      {
        "queue": "step-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "STREAM_BUCKET",
      "bucket_name": "workflow-streams"
    }
  ],
  "vars": {
    "DEPLOYMENT_ID": "cloudflare",
    "WORKFLOW_TARGET_WORLD": "workflow-cloudflare-world"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".cloudflare/assets"
  }
}
