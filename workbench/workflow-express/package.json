{
  "name": "workflow-express-example",
  "private": true,
  "type": "module",
  "imports": {
    "#client": "./.well-known/workflow/v1/client.js"
  },
  "scripts": {
    "build": "workflow build && tsc -p tsconfig.json",
    "start": "node ./dist/server.js",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"node --watch ./dist/server.js\""
  },
  "dependencies": {
    "express": "4.19.2",
    "workflow": "workspace:*",
    "workflow-express": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "catalog:",
    "concurrently": "9.2.1",
    "typescript": "catalog:"
  }
}
