{
  "name": "workflow-fastify-example",
  "version": "1.0.0",
  "description": "Example Fastify application with Workflow DevKit integration",
  "type": "module",
  "scripts": {
    "dev": "pnpm tsc && fastify start --watch -l info dist/server.js",
    "build": "pnpm build:workflows && tsc",
    "build:workflows": "workflow build",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "workflow": "workspace:*",
    "workflow-fastify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fastify-cli": "5.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
