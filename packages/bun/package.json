{
  "name": "workflow-bun",
  "version": "0.0.0",
  "description": "Bun integration helpers for Workflow DevKit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/bun"
  },
  "exports": {
    ".": "./dist/index.js",
    "./builder": "./dist/builder.js",
    "./server": "./dist/server.js",
    "./manifest": "./dist/manifest.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "tsc -p tsconfig.json --build --clean && rm -rf dist"
  },
  "dependencies": {
    "@workflow/builders": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.2",
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
