{
  "name": "workflow-cloudflare-world",
  "version": "4.0.1-beta.12",
  "description": "A World implementation based on Cloudflare",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "workflow-cloudflare-world": "dist/src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./worker": {
      "types": "./dist/src/worker.d.ts",
      "default": "./dist/src/worker.js"
    },
    "./container": {
      "types": "./dist/src/container-proxy.d.ts",
      "default": "./dist/src/container-proxy.js"
    },
    "./container-proxy": {
      "types": "./dist/src/container-proxy.d.ts",
      "default": "./dist/src/container-proxy.js"
    }
  },
  "scripts": {
    "build": "tsc && node ./scripts/copy-migrations.mjs",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "pnpm exec drizzle-kit --version && drizzle-kit push"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.30",
    "@inquirer/prompts": "^7.10.0",
    "@workflow/errors": "workspace:*",
    "@workflow/world": "workspace:*",
    "drizzle-orm": "^0.31.2",
    "seedrandom": "^3.0.5",
    "ulid": "^3.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/node": "catalog:",
    "@types/seedrandom": "^3.0.8",
    "@workflow/errors": "workspace:*",
    "@workflow/tsconfig": "workspace:*",
    "@workflow/world-testing": "workspace:*",
    "drizzle-kit": "^0.22.7",
    "vitest": "catalog:",
    "wrangler": "^4.45.2"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@10.15.1"
}
