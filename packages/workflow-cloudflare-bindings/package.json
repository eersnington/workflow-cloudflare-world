{
  "name": "workflow-cloudflare-bindings",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Worker-safe bindings and Vite plugin for forwarding Workflow execution to a user-hosted Cloudflare runtime (containers / Durable Objects / service URL).",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "lint": "echo \"no lint configured\"",
    "test": "echo \"no tests configured\""
  },
  "keywords": [
    "workflow",
    "cloudflare",
    "bindings",
    "vite",
    "worker",
    "wdk"
  ],
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "workflow": "*"
  },
  "peerDependenciesMeta": {
    "workflow": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./container-client": {
      "types": "./dist/container-client.d.ts",
      "import": "./dist/container-client.js",
      "require": "./dist/container-client.cjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/workflow"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
