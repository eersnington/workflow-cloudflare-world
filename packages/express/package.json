{
  "name": "workflow-express",
  "version": "4.0.1-beta.14",
  "description": "Express helpers for Vercel Workflow DevKit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publish-branch": "bun-node-support",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/express"
  },
  "exports": {
    ".": "./dist/index.js",
    "./builder": "./dist/builder.js",
    "./server": "./dist/server.js",
    "./manifest": "./dist/manifest.js",
    "./register": "./dist/register.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "tsc -p tsconfig.json --build --clean && rm -rf dist",
    "test": "vitest run src"
  },
  "dependencies": {
    "@workflow/builders": "workspace:*",
    "@workflow/swc-plugin": "workspace:*",
    "@swc-node/register": "1.8.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "express": "4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
