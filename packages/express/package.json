{
  "name": "workflow-express",
  "version": "4.1.0-beta.4",
  "description": "Community maintained Express middleware and handlers for Vercel Workflow DevKit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publish-branch": "bun-node-support",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eersnington/workflow-cloudflare-world.git",
    "directory": "packages/express"
  },
  "exports": {
    ".": "./dist/index.js",
    "./workflows": "./dist/workflows.js",
    "./builder": "./dist/builder.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run src"
  },
  "dependencies": {
    "@workflow/builders": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "express": "4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
